generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NodeStatus {
  IDLE
  RUNNING
  LISTENING
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  email              String    @unique
  password           String
  spotifyAccountId   String?   @unique
  spotifyDisplayName String?
  spotifyConnectedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  node Node?

  sentFriendRequests     Friendship[] @relation("SentRequests")
  receivedFriendRequests Friendship[] @relation("ReceivedRequests")
}

model Lobby {
  id          String   @id @default(uuid())
  name        String   @default("")
  maxCapacity Int      @default(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nodes Node[]
}

model Node {
  id           String     @id @default(uuid())
  posX         Float      @default(0.0)
  posY         Float      @default(0.0)
  status       NodeStatus @default(IDLE)
  bpm          Int        @default(0)
  bpmEstimated Boolean    @default(false)
  isPlaying    Boolean    @default(false)
  songTitle    String     @default("")
  artist       String     @default("")

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relación con el Lobby actual del nodo
  lobbyId String?
  lobby   Lobby?  @relation(fields: [lobbyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Friendship {
  id         String           @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendshipStatus @default(PENDING)

  sender   User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([senderId, receiverId])
}
